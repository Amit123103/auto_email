# ==============================================================================
# Skytecher Cold Email Automation - Environment Configuration
# ==============================================================================

# --- Gmail SMTP Configuration ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SMTP_SERVER=smtp.gmail.com 
SMTP_PORT=587
USE_SSL=False
COMPANY_PHONE=+91

# --- AI Provider Configuration ---
# Options: 'nvidia', 'anthropic', or 'template'
AI_PROVIDER=nvidia
USE_AI=True

# --- NVIDIA NIM API Configuration (https://build.nvidia.com/) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# --- Anthropic Claude API Configuration ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Sending Rate Limits & Delays ---
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90
DAILY_SEND_LIMIT=250

# --- Email Preferences ---
EMAIL_LANGUAGE=English
TEST_RECIPIENT_EMAIL=skytechersolutions@gmail.com
