# ==============================================================================
# Skytecher Cold Email Automation - Environment Configuration
# ==============================================================================
# Rename this file to .env and fill in your actual credentials.
# NEVER commit your .env file to public version control!
# ==============================================================================

# --- Gmail SMTP Configuration ---
# Your sender Gmail address (must match sender in Skytecher config)
GMAIL_ADDRESS=skytechersolutions@gmail.com

# 16-character Google App Password (NOT your regular Gmail password)
# Generated from: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled on your Google Account)
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# SMTP Server & Port (Default: smtp.gmail.com, Port 587 for TLS, or 465 for SSL)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
USE_SSL=False

# --- AI Provider Configuration ---
# Choose your primary AI provider: 'nvidia', 'anthropic', or 'template'
AI_PROVIDER=nvidia
USE_AI=True

# --- NVIDIA NIM API Configuration (Recommended: High-Speed & High-Quality) ---
# Get your free NVIDIA API Key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Popular NVIDIA models:
#   meta/llama-3.1-70b-instruct
#   meta/llama-3.3-70b-instruct
#   nvidia/llama-3.1-nemotron-70b-instruct
#   mistralai/mixtral-8x22b-instruct
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Anthropic Claude API Configuration ---
# Your Anthropic API Key (from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Sending Rate Limits & Delay Configuration ---
# Random delay in seconds between consecutive emails (prevents spam flags)
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90

# Maximum number of emails allowed to send per day (Gmail max ~500, recommended 50-100)
DAILY_SEND_LIMIT=100

# --- Email Preferences ---
# Default language for email generation (e.g. English, Spanish, French, German)
EMAIL_LANGUAGE=English

# Optional test recipient for TEST mode (defaults to GMAIL_ADDRESS if empty)
TEST_RECIPIENT_EMAIL=skytechersolutions@gmail.com
